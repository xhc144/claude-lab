{
  "name": "hongyan-mail",
  "productName": "Hongyan Mail",
  "version": "1.1.1",
  "description": "鸿雁邮箱 — 本地运行的 Windows 多账户邮件客户端",
  "main": "dist/main/index.js",
  "author": "Hongyan Mail",
  "license": "MIT",
  "homepage": "https://github.com/xhc144/claude-lab/tree/main/hongyan-mail",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/build.mjs && node tests/e2e/run.mjs",
    "test:hover": "node scripts/build.mjs && node tests/e2e/hover-audit.mjs",
    "mail-server": "node scripts/test-server/mail-server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-virtual": "3.14.17",
    "@types/he": "1.2.3",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "he": "1.2.0",
    "html-to-text": "10.0.1",
    "iconv-lite": "0.7.3",
    "imapflow": "2.4.0",
    "libmime": "5.4.7",
    "lucide-react": "1.55.0",
    "mailparser": "3.9.38",
    "motion": "14.1.0",
    "nodemailer": "10.1.0",
    "playwright-core": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resedit": "3.1.0",
    "smtp-server": "3.19.21",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zustand": "5.0.15"
  }
}
