{
  "name": "emberstack",
  "version": "1.0.0",
  "description": "薪火纪 EMBERSTACK：卡牌堆叠文明策略游戏——采集、合成、科技、探索、战斗、光与灰雾，以及可以完全托管的自主 AI 玩家",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:ai && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:ai": "node scripts/ai-bench.mjs --quick",
    "test:e2e": "playwright test",
    "test:dist": "node scripts/build.mjs && EMBER_APP=/dist/emberstack.html playwright test",
    "lint": "node scripts/check.mjs && node scripts/build.mjs --check",
    "bench": "node scripts/ai-bench.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
