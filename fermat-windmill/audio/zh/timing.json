  "voice": "en_examiner",
  "dur": 4.963,
  "sentences": [
   {
    "start": 0.0,
    "end": 4.963,
    "text": "Is that condition enough for any number, not just for primes?",
    "lang": "en"
   }
  ]
 },
 "a3": {
