<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SnapTool</AssemblyName>
    <RootNamespace>SnapTool</RootNamespace>
    <Product>SnapTool</Product>
    <Version>1.0.0</Version>
    <!-- WPF0001: Fluent 主题 (ThemeMode) 仍标记为实验性；WFO0003: DPI 感知由 manifest 给 WPF 用，WinForms 只用托盘 -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只用 WinForms 的托盘图标，避免与 WPF 类型重名 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
