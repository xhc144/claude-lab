<Window x:Class="SnapTool.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapTool 编辑" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,5" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActionGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <!-- ============ 画布 ============ -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#FF141417" PreviewMouseWheel="Scroller_PreviewMouseWheel" Focusable="False">
            <Border x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                </Border.LayoutTransform>
                <Grid x:Name="Stage">
                    <Grid x:Name="Surface" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="BaseImage" Stretch="Fill" />
                        <Canvas x:Name="Ink" Background="Transparent"
                                MouseLeftButtonDown="Ink_MouseLeftButtonDown"
                                MouseMove="Ink_MouseMove"
                                MouseLeftButtonUp="Ink_MouseLeftButtonUp" />
                    </Grid>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- ============ 工具条（单独一行，不压在图片上） ============ -->
        <Border Background="#FF141417" BorderThickness="0,0,0,1" BorderBrush="#18FFFFFF">
        <Border Style="{StaticResource FloatingBar}" HorizontalAlignment="Center" Margin="12,8,12,8">
            <WrapPanel VerticalAlignment="Center">
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Select" x:Name="SelectTool" Checked="Tool_Checked" Content="&#xE8B0;" ToolTip="选择 / 移动 (V)　选中后点颜色可换色，Delete 删除" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Rect" Checked="Tool_Checked" Content="&#xE739;" ToolTip="矩形 (R)　按住 Shift 画正方形" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Ellipse" Checked="Tool_Checked" Content="&#xEA3A;" ToolTip="椭圆 (E)　按住 Shift 画圆" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Arrow" Checked="Tool_Checked" Content="&#xE72A;" ToolTip="箭头 (A)　按住 Shift 锁定 45°" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Line" Checked="Tool_Checked" Content="&#xE738;" ToolTip="直线 (L)　按住 Shift 锁定 45°" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Pen" Checked="Tool_Checked" Content="&#xEE56;" ToolTip="画笔 (P)" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Highlighter" Checked="Tool_Checked" Content="&#xE7E6;" ToolTip="荧光笔 (H)" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Text" Checked="Tool_Checked" Content="&#xE8D2;" ToolTip="文字 (T)　Ctrl+Enter 或点击别处完成" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Number" Checked="Tool_Checked" ToolTip="序号 (N)　每点一次自动加 1">
                    <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.6"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                        <TextBlock Text="1" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Mosaic" Checked="Tool_Checked" Content="&#xE80A;" ToolTip="马赛克 (M)　框选要打码的区域" />
                <RadioButton Style="{StaticResource ToolToggle}" Tag="Blur" Checked="Tool_Checked" Content="&#xE727;" ToolTip="模糊 (B)　框选要模糊的区域" />

                <Rectangle Style="{StaticResource BarDivider}" />
                <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                <Rectangle Style="{StaticResource BarDivider}" />

                <Slider x:Name="ThicknessSlider" Width="70" Minimum="1" Maximum="20" Value="4" Margin="4,0"
                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                        ToolTip="粗细 / 字号 / 马赛克颗粒" />
                <TextBlock Text="{Binding Value, ElementName=ThicknessSlider}" Width="20" Foreground="#AAFFFFFF"
                           VerticalAlignment="Center" TextAlignment="Center" FontSize="12" />

                <Rectangle Style="{StaticResource BarDivider}" />
                <Button Style="{StaticResource IconButton}" x:Name="UndoButton" Width="34" Height="34" FontSize="15" Content="&#xE7A7;" Click="Undo_Click" ToolTip="撤销 (Ctrl+Z)" />
                <Button Style="{StaticResource IconButton}" x:Name="RedoButton" Width="34" Height="34" FontSize="15" Content="&#xE7A6;" Click="Redo_Click" ToolTip="重做 (Ctrl+Y)" />
                <Button Style="{StaticResource IconButton}" x:Name="DeleteButton" Width="34" Height="34" FontSize="15" Content="&#xE74D;" Click="Delete_Click" ToolTip="删除选中的标注 (Delete)" />
                <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="15" Content="&#xED62;" Click="ClearAll_Click" ToolTip="清除全部标注" />
            </WrapPanel>
        </Border>
        </Border>

        <!-- ============ 右侧：尺寸与导出 ============ -->
        <Border Grid.Column="1" Grid.RowSpan="3" BorderThickness="1,0,0,0" BorderBrush="#22FFFFFF"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <DockPanel>
                <!-- 底部操作按钮 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,18">
                    <Button HorizontalAlignment="Stretch" Padding="0,9" Click="SaveAs_Click"
                            Style="{DynamicResource AccentButtonStyle}" ToolTip="选择位置保存 (Ctrl+Shift+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE792;" />
                            <TextBlock Style="{StaticResource ActionText}" Text="另存为…" />
                        </StackPanel>
                    </Button>
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Button Margin="0,0,4,0" Padding="0,8" HorizontalAlignment="Stretch" Click="Copy_Click" ToolTip="按当前尺寸复制到剪贴板 (Ctrl+C)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE8C8;" />
                                <TextBlock Style="{StaticResource ActionText}" Text="复制" />
                            </StackPanel>
                        </Button>
                        <Button Margin="2,0" Padding="0,8" HorizontalAlignment="Stretch" Click="QuickSave_Click" ToolTip="保存到默认目录 (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE74E;" />
                                <TextBlock Style="{StaticResource ActionText}" Text="保存" />
                            </StackPanel>
                        </Button>
                        <Button Margin="4,0,0,0" Padding="0,8" HorizontalAlignment="Stretch" Click="Pin_Click" ToolTip="钉在桌面最上层">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ActionGlyph}" Text="&#xE718;" />
                                <TextBlock Style="{StaticResource ActionText}" Text="钉图" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,18,8">
                        <TextBlock Style="{StaticResource Section}" Text="尺寸" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WidthBox" TextChanged="WidthBox_TextChanged" ToolTip="宽（像素）" />
                            <ToggleButton Grid.Column="1" x:Name="LockRatio" IsChecked="True" Margin="6,0" Padding="7,6"
                                          ToolTip="锁定宽高比" Click="LockRatio_Click">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE72E;" />
                            </ToggleButton>
                            <TextBox Grid.Column="2" x:Name="HeightBox" TextChanged="HeightBox_TextChanged" ToolTip="高（像素）" />
                        </Grid>
                        <Grid Margin="0,3,0,0" Opacity="0.5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="宽 px" FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="高 px" FontSize="11" HorizontalAlignment="Center" />
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,10,-6,0">
                            <Button Style="{StaticResource Chip}" Content="25%" Tag="25" Click="Scale_Click" />
                            <Button Style="{StaticResource Chip}" Content="50%" Tag="50" Click="Scale_Click" />
                            <Button Style="{StaticResource Chip}" Content="75%" Tag="75" Click="Scale_Click" />
                            <Button Style="{StaticResource Chip}" Content="原尺寸" Tag="100" Click="Scale_Click" />
                            <Button Style="{StaticResource Chip}" Content="150%" Tag="150" Click="Scale_Click" />
                            <Button Style="{StaticResource Chip}" Content="200%" Tag="200" Click="Scale_Click" />
                            <Button Style="{StaticResource Chip}" Content="宽 1080" Tag="w1080" Click="Scale_Click" ToolTip="宽度设为 1080 像素（手机屏幕宽度）" />
                            <Button Style="{StaticResource Chip}" Content="宽 1920" Tag="w1920" Click="Scale_Click" ToolTip="宽度设为 1920 像素" />
                        </UniformGrid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="缩放算法" />
                        <ComboBox x:Name="AlgoBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="高质量（文字清晰）" />
                            <ComboBoxItem Content="平滑（速度快）" />
                            <ComboBoxItem Content="像素风（不模糊）" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="DPI" />
                        <ComboBox x:Name="DpiBox" IsEditable="True" Text="96" HorizontalAlignment="Stretch"
                                  SelectionChanged="Option_Changed" LostFocus="Option_Changed">
                            <ComboBoxItem Content="72" />
                            <ComboBoxItem Content="96" />
                            <ComboBoxItem Content="150" />
                            <ComboBoxItem Content="300" />
                        </ComboBox>
                        <TextBlock x:Name="PrintSizeText" Opacity="0.5" FontSize="11" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource Section}" Text="导出" />
                        <ComboBox x:Name="FormatBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Format_Changed">
                            <ComboBoxItem Content="PNG · 无损" />
                            <ComboBoxItem Content="JPG · 体积小" />
                            <ComboBoxItem Content="PDF · 可分页打印" />
                            <ComboBoxItem Content="BMP" />
                            <ComboBoxItem Content="TIFF" />
                        </ComboBox>

                        <StackPanel x:Name="QualityPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding Value, ElementName=QualitySlider, StringFormat={}{0:0}}" DockPanel.Dock="Right" Opacity="0.8" />
                                <TextBlock Text="质量" Opacity="0.8" />
                            </DockPanel>
                            <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="90" IsSnapToTickEnabled="True"
                                    TickFrequency="1" ValueChanged="Option_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="PdfPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PDF 页面" />
                            <ComboBox x:Name="PdfPageBox" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="原尺寸单页" />
                                <ComboBoxItem Content="A4 纵向 · 长图自动分页" />
                                <ComboBoxItem Content="A4 横向 · 长图自动分页" />
                                <ComboBoxItem Content="Letter 纵向 · 自动分页" />
                            </ComboBox>
                        </StackPanel>

                        <DockPanel Margin="0,14,0,0">
                            <ComboBox x:Name="LimitUnit" DockPanel.Dock="Right" SelectedIndex="0" MinWidth="64" SelectionChanged="Option_Changed"
                                      IsEnabled="{Binding IsChecked, ElementName=LimitSize}">
                                <ComboBoxItem Content="KB" />
                                <ComboBoxItem Content="MB" />
                            </ComboBox>
                            <TextBox x:Name="LimitBox" DockPanel.Dock="Right" Text="500" Width="70" Margin="6,0" TextChanged="Option_Changed"
                                     IsEnabled="{Binding IsChecked, ElementName=LimitSize}" />
                            <CheckBox x:Name="LimitSize" Content="体积上限" Click="Option_Changed" MinWidth="0" />
                        </DockPanel>

                        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8" Background="#14FFFFFF">
                            <StackPanel>
                                <TextBlock Text="输出" FontSize="11" Opacity="0.5" Margin="0,0,0,3" />
                                <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Text="计算中…" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Padding="12,2" Background="#FF1B1B1F" BorderThickness="0,1,0,0" BorderBrush="#18FFFFFF">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="缩小 (Ctrl+滚轮)" />
                    <TextBlock x:Name="ZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Opacity="0.8" Text="100%" />
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="放大 (Ctrl+滚轮)" />
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE9A6;" Click="ZoomFit_Click" ToolTip="适应窗口 (Ctrl+0)" />
                    <Button Style="{StaticResource IconButton}" Width="34" Height="30" FontSize="12" FontFamily="Segoe UI" Content="1:1" Click="Zoom100_Click" ToolTip="实际像素" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
