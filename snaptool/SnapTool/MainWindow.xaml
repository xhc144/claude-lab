<Window x:Class="SnapTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapTool" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <!-- 外边距留给阴影 -->
    <Border Style="{StaticResource FloatingBar}" Margin="14" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/app.ico" Width="22" Height="22" Margin="8,0,6,0"
                   VerticalAlignment="Center" Cursor="SizeAll" ToolTip="拖动这里移动工具条" />

            <Rectangle Style="{StaticResource BarDivider}" />

            <Button Style="{StaticResource IconButton}" x:Name="RegionButton" Content="&#xE7A8;" Click="Region_Click" />
            <Button Style="{StaticResource IconButton}" x:Name="LongButton" Content="&#xE896;" Click="Long_Click" />
            <Button Style="{StaticResource IconButton}" x:Name="FullButton" Content="&#xE740;" Click="Full_Click" />
            <Button Style="{StaticResource IconButton}" Content="&#xE823;" Click="Delay_Click" ToolTip="延时截图（3 秒后开始，可以截下拉菜单）" />

            <Rectangle Style="{StaticResource BarDivider}" />

            <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Click="Open_Click" ToolTip="打开图片：标注、改尺寸、压缩、转 PDF" />
            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Click="Folder_Click" ToolTip="打开保存目录" />
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="设置" />

            <Rectangle Style="{StaticResource BarDivider}" />

            <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="12" Width="30" Click="Hide_Click"
                    ToolTip="收到托盘（快捷键依然可用）" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="12" Width="30" Click="Exit_Click"
                    ToolTip="退出 SnapTool" />
        </StackPanel>
    </Border>
</Window>
