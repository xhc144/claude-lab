<Window x:Class="SnapTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapTool 设置" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,8" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,14,16,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22,4,22,22">
        <TextBlock Style="{StaticResource Group}" Text="保存" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="保存位置" />
                <TextBox Grid.Column="1" x:Name="FolderBox" IsReadOnly="True" Margin="0,0,0,8" />
                <Button Grid.Column="2" Content="更改…" Margin="8,0,0,8" Click="ChangeFolder_Click" />
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="快速保存格式" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FormatBox" Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="120"
                          SelectionChanged="FormatBox_SelectionChanged">
                    <ComboBoxItem Content="PNG" />
                    <ComboBoxItem Content="JPG" />
                </ComboBox>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Group}" Text="快捷键（点输入框，直接按下新的组合键；Backspace 清除）" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="区域截图" />
                <TextBox Grid.Column="1" x:Name="RegionKeyBox" Tag="region" Margin="0,0,0,8" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                <TextBlock Grid.Column="2" x:Name="RegionKeyState" Style="{StaticResource Label}" Margin="10,0,0,8" />

                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="长截图" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="LongKeyBox" Tag="long" Margin="0,0,0,8" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LongKeyState" Style="{StaticResource Label}" Margin="10,0,0,8" />

                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="全屏截图" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FullKeyBox" Tag="full" Margin="0,0,0,8" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="FullKeyState" Style="{StaticResource Label}" Margin="10,0,0,8" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Group}" Text="启动" />
        <Border Style="{StaticResource Card}" Padding="16,10">
            <StackPanel>
                <CheckBox x:Name="ShowBarBox" Content="启动时显示浮动工具条" Click="ShowBarBox_Click" />
                <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Click="AutoStartBox_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Window>
