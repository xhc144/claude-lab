%% moteng.sty — 墨誊 Moteng 生成的 TeX 共用的环境与宏
%%   \usepackage[style=chat]{moteng}   对话体（ctexart）
%%   \usepackage[style=notes]{moteng}  讲义体（墨经 mojing-notes）
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{moteng}[2026/10/16 v1.0 Moteng chat-to-TeX support]

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=mt, prefix=mt@}
\DeclareStringOption[chat]{style}
\ProcessKeyvalOptions*

\RequirePackage{xcolor}
\RequirePackage{amsmath, amssymb, mathtools}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fvextra}
\RequirePackage{array, booktabs, colortbl, xltabular}
\RequirePackage[export]{adjustbox}
\RequirePackage{enumitem}
\RequirePackage{cancel}
\RequirePackage[normalem]{ulem}
\IfFileExists{mhchem.sty}{\RequirePackage[version=4]{mhchem}}{}

%% ---------------------------------------------------------------------------
%% 颜色
%% ---------------------------------------------------------------------------
\def\mt@notes{notes}
\ifx\mt@style\mt@notes
  \colorlet{mtAccent}{mjAccent}
  \colorlet{mtInk}{mjInk}
  \colorlet{mtGray}{mjGray}
  \colorlet{mtRule}{mjRule}
  \colorlet{mtPaper}{mjLight}
  \colorlet{mtQuestionBg}{mjAccent!5!white}
\else
  \definecolor{mtAccent}{HTML}{2F4F8F}
  \definecolor{mtInk}{HTML}{1C1C1C}
  \definecolor{mtGray}{HTML}{6B6F76}
  \definecolor{mtRule}{HTML}{C9CDD4}
  \definecolor{mtPaper}{HTML}{F5F6F8}
  \definecolor{mtQuestionBg}{HTML}{EEF2FA}
\fi
\definecolor{mtCodeBg}{HTML}{F7F7F5}
\definecolor{mtCodeRule}{HTML}{DADAD5}
\definecolor{mtBad}{HTML}{A33A2B}
\definecolor{mtThink}{HTML}{8A8F98}

