\DeclareRobustCommand\mtcross{\ensuremath{\times}}
\DeclareRobustCommand\mtwarn{\textbf{!}}
\DeclareRobustCommand\mtidea{\ensuremath{\star}}
\DeclareRobustCommand\mtpin{\ensuremath{\triangleright}}

