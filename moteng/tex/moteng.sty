%% \mtHLkw{…} 等：每个高亮类别一个单参数宏（fvextra 会在参数里插入断行点）
\newcommand\mtHLkw[1]{\textbf{\textcolor{mtHLkw}{#1}}}
\newcommand\mtHLco[1]{\textit{\textcolor{mtHLco}{#1}}}
\newcommand\mtHLbi[1]{\textcolor{mtHLbi}{#1}}
\newcommand\mtHLty[1]{\textcolor{mtHLty}{#1}}
\newcommand\mtHLnu[1]{\textcolor{mtHLnu}{#1}}
\newcommand\mtHLst[1]{\textcolor{mtHLst}{#1}}
\newcommand\mtHLfn[1]{\textcolor{mtHLfn}{#1}}
\newcommand\mtHLat[1]{\textcolor{mtHLat}{#1}}
\newcommand\mtHLpa[1]{\textcolor{mtHLpa}{#1}}
\newcommand\mtHLme[1]{\textcolor{mtHLme}{#1}}
\newcommand\mtHLva[1]{\textcolor{mtHLva}{#1}}
\newcommand\mtHLad[1]{\textcolor{mtHLad}{#1}}
\newcommand\mtHLde[1]{\textcolor{mtHLde}{#1}}
\newcommand\mtHLop[1]{\textcolor{mtHLop}{#1}}
\def\mtBS{\char92\relax}
\def\mtLB{\char123\relax}
\def\mtRB{\char125\relax}

%% ---------------------------------------------------------------------------
%% 代码块
%% ---------------------------------------------------------------------------
\fvset{breaklines=true, breakanywhere=true, breaknonspaceingroup=true, fontsize=\small, tabsize=4,
  formatcom=\ifdefined\xeCJKVerbAddon\xeCJKVerbAddon\fi,
  breaksymbolleft={\color{mtGray}\tiny\ensuremath{\hookrightarrow}}}
\newtcolorbox{mtcodebox}[1]{%
  enhanced, breakable, colback=mtCodeBg, colframe=mtCodeRule, boxrule=.4pt, arc=2pt,
  left=6pt, right=6pt, top=4pt, bottom=4pt, before skip=.6\baselineskip, after skip=.6\baselineskip,
  overlay unbroken and first={%
    \if\relax\detokenize{#1}\relax\else
      \node[anchor=north east, inner sep=2pt, font=\scriptsize\sffamily\color{mtGray}]
        at ([xshift=-4pt,yshift=-2pt]frame.north east) {#1};%
    \fi}}

%% ---------------------------------------------------------------------------
%% 提问、引用、提示框
%% ---------------------------------------------------------------------------
\newtcolorbox{mtquestion}[1]{%
  enhanced, breakable, colback=mtQuestionBg, colframe=mtQuestionBg, boxrule=0pt, arc=3pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  before skip=\baselineskip, after skip=.8\baselineskip,
  borderline west={2pt}{0pt}{mtAccent},
  fontupper=\normalsize,
  before upper={{\sffamily\bfseries\small\color{mtAccent}#1}\par\smallskip}}

\newtcolorbox{mtquote}{%
  enhanced, breakable, colback=white, colframe=white, boxrule=0pt, arc=0pt,
  left=8pt, right=0pt, top=1pt, bottom=1pt, before skip=.5\baselineskip, after skip=.5\baselineskip,
  borderline west={1.5pt}{0pt}{mtRule}, fontupper=\color{mtInk!85}}

\newtcolorbox{mtnote}[2]{%
  enhanced, breakable, colback=mtPaper, colframe=mtRule, boxrule=.4pt, arc=2pt,
  left=8pt, right=8pt, top=5pt, bottom=5pt, before skip=.7\baselineskip, after skip=.7\baselineskip,
  #1,
  before upper={\if\relax\detokenize{#2}\relax\else{\sffamily\bfseries\small\color{mtGray}#2}\par\smallskip\fi}}
\tcbset{mtwidget/.style={borderline={.4pt}{0pt}{mtRule,dashed}, boxrule=0pt, colframe=mtPaper},
  mtthinking/.style={colback=white, fontupper=\small\color{mtThink}},
  mtdetails/.style={}}

%% ---------------------------------------------------------------------------
%% 对话标签、题头
%% ---------------------------------------------------------------------------
\newcommand\mtanswerhead[1]{%
  \par\addvspace{.3\baselineskip}%
  \noindent{\sffamily\bfseries\small\color{mtAccent}#1}\par\nobreak\smallskip\@afterheading}
\newcommand\mtrule{\par\smallskip\noindent{\color{mtRule}\rule{\linewidth}{.4pt}}\par\smallskip}
\newcommand\mtturnsep{\par\bigskip\noindent{\color{mtRule}\rule{\linewidth}{.3pt}}\par\bigskip}

%% ---------------------------------------------------------------------------
%% 图片、链接、行内代码
%% ---------------------------------------------------------------------------
\newcommand\mtimage[2]{%
  \par\smallskip
  \begin{center}
    \includegraphics[max width=\linewidth, max height=.45\textheight, keepaspectratio]{#1}%
    \if\relax\detokenize{#2}\relax\else\par\smallskip{\small\color{mtGray}#2}\fi
  \end{center}\par}
\newcommand\mtmissing[1]{{\small\color{mtGray}[图片：#1]}}
\newcommand\mtcode[1]{{\ttfamily\small\color{mtInk}#1}}

%% ---------------------------------------------------------------------------
%% 编译失败的公式：显示源码
%% ---------------------------------------------------------------------------
\newcommand\mtbadmath[1]{{\ttfamily\small\color{mtBad}#1}}
\newtcolorbox{mtbaddisplay}{%
  enhanced, breakable, colback=mtBad!4!white, colframe=mtBad!40!white, boxrule=.4pt, arc=2pt,
  left=6pt, right=6pt, top=3pt, bottom=3pt, before skip=.5\baselineskip, after skip=.5\baselineskip,
  fontupper=\small}

%% ---------------------------------------------------------------------------
%% 符号
%% ---------------------------------------------------------------------------
