# 复制为 .env 后填写（也可以直接设置环境变量 DASHSCOPE_API_KEY）；.env 不会被提交
QWEN_TTS_API_KEY=
QWEN_TTS_MODEL=qwen-audio-3.0-tts-plus
QWEN_TTS_VOICE=longanlingxin
QWEN_TTS_RATE=0.95
# 百炼 SpeechSynthesizer 流式接口（国际站密钥改用 https://dashscope-intl.aliyuncs.com）：
QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com
QWEN_TTS_PROTOCOL=speech
# 若密钥来自 OpenAI 兼容的中转，改成：
# QWEN_TTS_BASE_URL=https://你的中转地址/v1
# QWEN_TTS_PROTOCOL=openai
