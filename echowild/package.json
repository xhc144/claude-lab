{
  "name": "echowild",
  "version": "1.0.0",
  "description": "回响荒野 Echowild：原创三维开放世界沙盒游戏——探索、建造、生存、冒险与创造",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:dist",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:dist": "node scripts/build.mjs && ECHOWILD_APP=/dist/echowild.html playwright test",
    "lint": "node scripts/build.mjs --check",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
