{
  "name": "myriad",
  "version": "1.0.0",
  "description": "万象 MYRIAD：文明演化与创世模拟沙盒——地形、气候、生态、物种演化、城市、国家、贸易、科技、外交、战争、宗教与社会变革",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:dist",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:dist": "node scripts/build.mjs && MYRIAD_APP=/dist/myriad.html playwright test",
    "lint": "node scripts/check.mjs && node scripts/build.mjs --check",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
