{
  "name": "phonica",
  "productName": "Phonica",
  "version": "1.0.0",
  "description": "声准 Phonica：英语口语训练与发音评测（本地音素级评测 + 可选 AI 深度分析）",
  "author": {
    "name": "claude-lab"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.mjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-transform-types --no-warnings tests/engine.test.ts tests/export.test.ts",
    "fetch-models": "node scripts/fetch-models.mjs",
    "selftest": "electron . --self-test selftest.json",
    "dist:win": "node scripts/build.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@breezystack/lamejs": "1.2.7",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "charsiu-js": "0.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.10",
    "fflate": "0.8.3",
    "phonemizer": "1.2.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  },
  "dependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "homepage": "https://github.com/xhc144/claude-lab/tree/main/phonica",
  "build": {
    "appId": "com.claudelab.phonica",
    "productName": "Phonica",
    "copyright": "Copyright © 2026 claude-lab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx",
          "*.json"
        ]
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Phonica",
      "artifactName": "Phonica-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "声准 Phonica",
      "uninstallDisplayName": "声准 Phonica ${version}",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "unicode": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/license.txt"
    },
    "compression": "normal"
  }
}
